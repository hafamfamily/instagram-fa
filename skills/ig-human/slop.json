  "structures": [
    {"id": "not-just", "regex": "(?:این|اون|آن) فقط (?:یک|یه) [^.!؟?\\n]{2,50} نیست[،,]? (?:بلکه|یه|یک)", "name": "«این فقط X نیست، بلکه Y»", "fix": "همان یک حرفی را که منظورت است بگو. نیمهٔ اول را حذف کن."},
    {"id": "not-only", "regex": "نه تنها[^.!؟?\\n]{2,80}بلکه", "name": "«نه تنها X بلکه Y»", "fix": "دو جمله کن یا نیمهٔ ضعیف‌تر را بردار."},
    {"id": "rhetorical-open", "regex": "(?m)^\\s*آیا (?:تا به حال|تابحال|تا حالا|می‌دانستید|میدونستید)[^؟?\\n]{0,80}[؟?]", "name": "شروع با «آیا تا به حال...؟»", "fix": "سؤال بلاغی را حذف کن و از خود جواب شروع کن."},
    {"id": "colon-reveal", "regex": "(?:جواب|راز|حقیقت|نکته) (?:ساده|اینجاست|این است|اینه)\\s*:", "name": "«راز ساده است:»", "fix": "خود حرف را بزن؛ نمایش لازم نیست."},
    {"id": "emoji-bullets", "regex": "(?m)^\\s*(?:✅|🚀|✨|💡|🔥|👉|📌)\\s", "name": "فهرست با ایموجی در ابتدای هر خط", "fix": "حداکثر در یک فهرست؛ نه همه‌جا."},
    {"id": "triple-adj", "regex": "[آ-ی‌]{3,}، [آ-ی‌]{3,} و [آ-ی‌]{3,}(?: (?:است|هست|می‌شود|باشد))", "name": "سه صفت پشت هم («ساده، سریع و کاربردی است»)", "fix": "یکی را نگه دار و برایش مثال بیاور."}
